{
  "id": "ccgui.client-context-bridge",
  "name": "跨客户端上下文桥接 (CCB)",
  "version": "1.0.2",
  "minAppVersion": "1.0.0",
  "sdkVersion": ">=0.3.20",
  "description": "在不同 AI CLI 客户端之间自动维护和接续任务上下文，支持按工作区独立启停。",
  "author": "MurasameCyan",
  "repo": "MurasameCyan/ccgui-plugin-client-context-bridge",
  "icon": "docs/icon.svg",
  "screenshots": [
    "docs/screenshot-settings.png",
    "docs/screenshot-workspace-menu.png"
  ],
  "license": "MIT",
  "keywords": ["context", "handoff", "bridge", "workspace", "productivity"],
  "tier": "js",
  "permissions": [
    "storage",
    "ui:settings-section",
    "ui:workspace-menu",
    "i18n",
    "events",
    "network:none",
    "session.lifecycle.read",
    "runtime.events.read",
    "runtime.switch.observe",
    "prompt.contribute.internal",
    "workspace.metadata.read",
    "host:workspace",
    "plugin.storage"
  ]
}
